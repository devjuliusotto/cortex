{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "center": true,
        "decorations": true,
        "height": 920,
        "minHeight": 720,
        "minWidth": 1100,
        "resizable": true,
        "title": "Cortex",
        "width": 1440
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "dev.cortex.workspace",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/devjuliusotto/cortex/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFNDhBQTY4RkM1OThGOQpSV1Q1bU1XUHBvcmtCa0JNTmZKZWtQbEdqSDcybEM3LzVRZ0grOXVWdm1XWW1tMlpIR0JUMjlCdAo=",
      "windows": {
        "installMode": "basicUi"
      }
    }
  },
  "productName": "Cortex",
  "version": "0.1.24"
}
